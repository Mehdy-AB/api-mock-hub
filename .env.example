# Host port published by docker compose (the container always listens on 3000)
HUB_PORT=3000

# First admin account, created only when there are no users yet.
# Leave ADMIN_PASSWORD empty to generate one; it is printed once in the logs.
ADMIN_USER=admin
ADMIN_PASSWORD=ad

# Leave empty to auto-generate and keep it in the data volume.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# When set, every mock call must send the header  x-mock-key: <value>
MOCK_API_KEY=

# Max JSON body size for the management API (large fixtures / imports)
BODY_LIMIT=5mb

# Only used outside docker
# PORT=3000
# DATA_DIR=./data
